# ==============================================================================
# ABC Health Care — AI Virtual Receptionist Environment Variables
# Copy this file to '.env' and fill in your actual credentials.
# Never commit '.env' containing real secrets to version control!
# ==============================================================================

# --- LiveKit Voice & WebRTC Credentials ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- OpenAI API Key ---
# Required for agent LLM reasoning, voice synthesis, and embeddings
OPENAI_API_KEY=your_openai_api_key_here

# --- PostgreSQL Database (Optional) ---
# If omitted or unavailable, the backend automatically falls back to local SQLite (data/clinic.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_receptionist
